diff --git a/cpp/src/system_tests/ftp_malformed_nak.cpp b/cpp/src/system_tests/ftp_malformed_nak.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..736a680a7c5387b9788b240369604460977267eb
--- /dev/null
+++ b/cpp/src/system_tests/ftp_malformed_nak.cpp
@@ -0,0 +1,113 @@
+#include "ftp_result_test_peer.hpp"
+#include <filesystem>
+
+namespace {
+struct DownloadDirectory {
+    std::filesystem::path path =
+        std::filesystem::temp_directory_path() /
+        ("mavsdk-ftp-nak-" +
+         std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    ~DownloadDirectory()
+    {
+        std::error_code error;
+        std::filesystem::remove_all(path, error);
+    }
+};
+} // namespace
+
+TEST_F(FtpResultTest, NakMissingErrorCode)
+{
+    for (const auto undeclared_code : {uint8_t{0}, uint8_t{10}}) {
+        SCOPED_TRACE(undeclared_code);
+        auto future = remove_directory();
+        auto sent = request(10);
+        ASSERT_TRUE(sent);
+        reply(*sent, 129, 0, {undeclared_code, 2});
+        EXPECT_EQ(result(future), Result::ProtocolError);
+    }
+}
+
+TEST_F(FtpResultTest, ErrnoNakMissingErrno)
+{
+    auto future = remove_directory();
+    auto sent = request(10);
+    ASSERT_TRUE(sent);
+    // The physical tail must not turn a one-byte NAK into FileDoesNotExist.
+    reply(*sent, 129, 1, {2, 2});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, ListNakMissingEofCode)
+{
+    auto future = start([this](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->list_directory_async(
+            "/directory",
+            [callback](Result value, mavsdk::Ftp::ListDirectoryData) { callback(value); });
+    });
+    auto sent = request(16);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 0, {6});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, OversizedNakStillIgnored)
+{
+    auto future = remove_directory();
+    auto sent = request(10);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 240, {2, 2});
+    reply(*sent, 128, 0, {});
+    EXPECT_EQ(result(future), Result::Success);
+}
+
+TEST_F(FtpResultTest, DownloadNakMissingEofCode)
+{
+    DownloadDirectory directory;
+    auto future = start([this, &directory](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->download_async(
+            "/empty",
+            directory.path.string(),
+            false,
+            [callback](Result value, mavsdk::Ftp::ProgressData) {
+                if (value != Result::Next) {
+                    callback(value);
+                }
+            });
+    });
+    auto sent = request(4);
+    ASSERT_TRUE(sent);
+    reply(*sent, 128, 4, {0, 0, 0, 0});
+    sent = request(5);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 0, {6});
+    sent = request(1);
+    ASSERT_TRUE(sent);
+    reply(*sent, 128, 0, {});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, TerminateNakMissingInvalidSessionCode)
+{
+    DownloadDirectory directory;
+    auto future = start([this, &directory](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->download_async(
+            "/empty",
+            directory.path.string(),
+            false,
+            [callback](Result value, mavsdk::Ftp::ProgressData) {
+                if (value != Result::Next) {
+                    callback(value);
+                }
+            });
+    });
+    auto sent = request(4);
+    ASSERT_TRUE(sent);
+    reply(*sent, 128, 4, {0, 0, 0, 0});
+    sent = request(5);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 1, {6});
+    sent = request(1);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 0, {4});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
diff --git a/cpp/src/system_tests/ftp_result_test_peer.hpp b/cpp/src/system_tests/ftp_result_test_peer.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..a700238a45a0247d9bda9b5e64774146a4c2f125
--- /dev/null
+++ b/cpp/src/system_tests/ftp_result_test_peer.hpp
@@ -0,0 +1,169 @@
+#pragma once
+
+#include "mavsdk.hpp"
+#include "mavlink_include.hpp"
+#include "plugins/ftp/ftp.hpp"
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <future>
+#include <iterator>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+// A deterministic peer using real MAVLink frames and the public raw connection.
+// It controls declared FTP sizes independently of the physically present bytes.
+class FtpResultTest : public testing::Test {
+protected:
+    using Result = mavsdk::Ftp::Result;
+
+    struct Request {
+        mavlink_message_t message{};
+        mavlink_file_transfer_protocol_t ftp{};
+    };
+
+    void SetUp() override
+    {
+        _mavsdk = std::make_unique<mavsdk::Mavsdk>(
+            mavsdk::Mavsdk::Configuration{mavsdk::ComponentType::GroundStation});
+        ASSERT_EQ(_mavsdk->add_any_connection("raw://"), mavsdk::ConnectionResult::Success);
+        _mavsdk->subscribe_raw_bytes_to_be_sent([this](const char* bytes, size_t length) {
+            mavlink_message_t buffer{};
+            mavlink_status_t buffer_status{};
+            mavlink_message_t message{};
+            mavlink_status_t status{};
+            for (size_t i = 0; i < length; ++i) {
+                if (mavlink_frame_char_buffer(
+                        &buffer,
+                        &buffer_status,
+                        static_cast<uint8_t>(bytes[i]),
+                        &message,
+                        &status) == MAVLINK_FRAMING_OK &&
+                    message.msgid == MAVLINK_MSG_ID_FILE_TRANSFER_PROTOCOL) {
+                    Request request;
+                    request.message = message;
+                    mavlink_msg_file_transfer_protocol_decode(&message, &request.ftp);
+                    {
+                        std::lock_guard<std::mutex> lock(_mutex);
+                        _requests.push_back(request);
+                    }
+                    _condition.notify_one();
+                }
+            }
+        });
+
+        mavlink_heartbeat_t heartbeat{};
+        heartbeat.type = MAV_TYPE_QUADROTOR;
+        heartbeat.autopilot = MAV_AUTOPILOT_PX4;
+        heartbeat.system_status = MAV_STATE_ACTIVE;
+        mavlink_message_t message{};
+        mavlink_status_t status{};
+        mavlink_msg_heartbeat_encode_status(1, 1, &status, &message, &heartbeat);
+        receive(message);
+        auto system = _mavsdk->first_autopilot(2.0);
+        ASSERT_TRUE(system);
+        _ftp = std::make_unique<mavsdk::Ftp>(system.value());
+    }
+
+    void receive(const mavlink_message_t& message)
+    {
+        std::vector<uint8_t> bytes(MAVLINK_MAX_PACKET_LEN);
+        const auto length = mavlink_msg_to_send_buffer(bytes.data(), &message);
+        _mavsdk->pass_received_raw_bytes(reinterpret_cast<const char*>(bytes.data()), length);
+    }
+
+    std::optional<Request> request(uint8_t opcode)
+    {
+        std::unique_lock<std::mutex> lock(_mutex);
+        const auto found = [&]() {
+            return std::find_if(_requests.begin(), _requests.end(), [opcode](const Request& r) {
+                return r.ftp.payload[3] == opcode;
+            });
+        };
+        if (!_condition.wait_for(
+                lock, std::chrono::seconds(2), [&]() { return found() != _requests.end(); })) {
+            return {};
+        }
+        const auto it = found();
+        const auto result = *it;
+        _requests.erase(_requests.begin(), std::next(it));
+        return result;
+    }
+
+    void reply(
+        const Request& request,
+        uint8_t opcode,
+        uint8_t declared_size,
+        const std::vector<uint8_t>& data,
+        uint8_t source_component = 1)
+    {
+        mavlink_file_transfer_protocol_t ftp{};
+        ASSERT_LE(data.size(), sizeof(ftp.payload) - 12);
+        ftp.target_system = request.message.sysid;
+        ftp.target_component = request.message.compid;
+        const auto sequence = static_cast<uint16_t>(
+            static_cast<uint16_t>(request.ftp.payload[0]) |
+            (static_cast<uint16_t>(request.ftp.payload[1]) << 8));
+        const auto response_sequence = static_cast<uint16_t>(sequence + 1);
+        ftp.payload[0] = static_cast<uint8_t>(response_sequence & 0xff);
+        ftp.payload[1] = static_cast<uint8_t>(response_sequence >> 8);
+        ftp.payload[3] = opcode;
+        ftp.payload[4] = declared_size;
+        ftp.payload[5] = request.ftp.payload[3];
+        std::copy(data.begin(), data.end(), ftp.payload + 12);
+        mavlink_message_t message{};
+        mavlink_status_t status{};
+        mavlink_msg_file_transfer_protocol_encode_status(
+            1, source_component, &status, &message, &ftp);
+        receive(message);
+    }
+
+    template<typename Start> std::future<Result> start(Start operation)
+    {
+        auto promise = std::make_shared<std::promise<Result>>();
+        auto future = promise->get_future();
+        operation([promise](Result result) { promise->set_value(result); });
+        return future;
+    }
+
+    std::future<Result> remove_directory()
+    {
+        return start([this](mavsdk::Ftp::ResultCallback callback) {
+            _ftp->remove_directory_async("/nonempty", std::move(callback));
+        });
+    }
+
+    Result result(std::future<Result>& future)
+    {
+        if (future.wait_for(std::chrono::seconds(2)) != std::future_status::ready) {
+            ADD_FAILURE() << "FTP operation did not complete";
+            return Result::Unknown;
+        }
+        return future.get();
+    }
+
+    void expect_remove_result(
+        Result expected,
+        const std::vector<uint8_t>& data = {2, 39},
+        uint8_t declared_size = 2,
+        uint8_t source_component = 1,
+        uint8_t opcode = 129)
+    {
+        auto future = remove_directory();
+        auto sent = request(10);
+        ASSERT_TRUE(sent);
+        reply(*sent, opcode, declared_size, data, source_component);
+        EXPECT_EQ(result(future), expected);
+    }
+
+    // Destroy the plugin and SDK before the callback's synchronization state.
+    std::mutex _mutex{};
+    std::condition_variable _condition{};
+    std::deque<Request> _requests{};
+    std::unique_ptr<mavsdk::Mavsdk> _mavsdk{};
+    std::unique_ptr<mavsdk::Ftp> _ftp{};
+};
