index 0000000000000000000000000000000000000000..736a680a7c5387b9788b240369604460977267eb
--- /dev/null
+++ b/cpp/src/system_tests/ftp_malformed_nak.cpp
@@ -0,0 +1,113 @@
+#include "ftp_result_test_peer.hpp"
+#include <filesystem>
+
+namespace {
+struct DownloadDirectory {
+    std::filesystem::path path =
+        std::filesystem::temp_directory_path() /
+        ("mavsdk-ftp-nak-" +
+         std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    ~DownloadDirectory()
+    {
+        std::error_code error;
+        std::filesystem::remove_all(path, error);
+    }
+};
+} // namespace
+
+TEST_F(FtpResultTest, NakMissingErrorCode)
+{
+    for (const auto undeclared_code : {uint8_t{0}, uint8_t{10}}) {
+        SCOPED_TRACE(undeclared_code);
+        auto future = remove_directory();
+        auto sent = request(10);
+        ASSERT_TRUE(sent);
+        reply(*sent, 129, 0, {undeclared_code, 2});
+        EXPECT_EQ(result(future), Result::ProtocolError);
+    }
+}
+
+TEST_F(FtpResultTest, ErrnoNakMissingErrno)
+{
+    auto future = remove_directory();
+    auto sent = request(10);
+    ASSERT_TRUE(sent);
+    // The physical tail must not turn a one-byte NAK into FileDoesNotExist.
+    reply(*sent, 129, 1, {2, 2});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, ListNakMissingEofCode)
+{
+    auto future = start([this](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->list_directory_async(
+            "/directory",
+            [callback](Result value, mavsdk::Ftp::ListDirectoryData) { callback(value); });
+    });
+    auto sent = request(16);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 0, {6});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, OversizedNakStillIgnored)
+{
+    auto future = remove_directory();
+    auto sent = request(10);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 240, {2, 2});
+    reply(*sent, 128, 0, {});
+    EXPECT_EQ(result(future), Result::Success);
+}
+
+TEST_F(FtpResultTest, DownloadNakMissingEofCode)
+{
+    DownloadDirectory directory;
+    auto future = start([this, &directory](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->download_async(
+            "/empty",
+            directory.path.string(),
+            false,
+            [callback](Result value, mavsdk::Ftp::ProgressData) {
+                if (value != Result::Next) {
+                    callback(value);
+                }
+            });
+    });
+    auto sent = request(4);
+    ASSERT_TRUE(sent);
+    reply(*sent, 128, 4, {0, 0, 0, 0});
+    sent = request(5);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 0, {6});
+    sent = request(1);
+    ASSERT_TRUE(sent);
+    reply(*sent, 128, 0, {});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, TerminateNakMissingInvalidSessionCode)
+{
+    DownloadDirectory directory;
+    auto future = start([this, &directory](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->download_async(
+            "/empty",
+            directory.path.string(),
+            false,
+            [callback](Result value, mavsdk::Ftp::ProgressData) {
+                if (value != Result::Next) {
+                    callback(value);
+                }
+            });
+    });
+    auto sent = request(4);
+    ASSERT_TRUE(sent);
+    reply(*sent, 128, 4, {0, 0, 0, 0});
+    sent = request(5);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 1, {6});
+    sent = request(1);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 0, {4});
+    EXPECT_EQ(result(future), Result::ProtocolError);
+}
