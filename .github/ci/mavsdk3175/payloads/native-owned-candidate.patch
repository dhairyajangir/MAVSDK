+#include "ftp_result_test_peer.hpp"
+#include "mavlink_ftp_client.hpp"
+#include <limits>
+#include <sstream>
+
+using Convention = mavsdk::Ftp::ServerErrnoConvention;
+
+TEST_F(FtpResultTest, UnspecifiedDirectoryErrnoRemainsProtocolError)
+{
+    expect_remove_result(Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, ExplicitDirectoryErrnoAndClear)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    expect_remove_result(Result::DirectoryNotEmpty);
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::Unspecified), Result::Success);
+    expect_remove_result(Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, ComponentErrnoProfilesAreIsolated)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    ASSERT_EQ(_ftp->set_target_compid(100), Result::Success);
+    expect_remove_result(Result::ProtocolError, {2, 39}, 2, 100);
+    ASSERT_EQ(_ftp->set_server_errno_convention(100, Convention::LinuxGeneric), Result::Success);
+    expect_remove_result(Result::DirectoryNotEmpty, {2, 39}, 2, 100);
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::Unspecified), Result::Success);
+    ASSERT_EQ(_ftp->set_target_compid(1), Result::Success);
+    expect_remove_result(Result::ProtocolError);
+    ASSERT_EQ(_ftp->set_target_compid(100), Result::Success);
+    expect_remove_result(Result::DirectoryNotEmpty, {2, 39}, 2, 100);
+}
+
+TEST_F(FtpResultTest, InvalidErrnoConfigurationDoesNotChangeSelection)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    for (const uint32_t component : {0u, 256u, std::numeric_limits<uint32_t>::max()}) {
+        SCOPED_TRACE(component);
+        EXPECT_EQ(
+            _ftp->set_server_errno_convention(component, Convention::LinuxGeneric),
+            Result::InvalidParameter);
+    }
+    for (const auto convention :
+         {Convention::Unknown, static_cast<Convention>(-1), static_cast<Convention>(255)}) {
+        EXPECT_EQ(_ftp->set_server_errno_convention(1, convention), Result::InvalidParameter);
+    }
+    EXPECT_EQ(_ftp->set_server_errno_convention(255, Convention::LinuxGeneric), Result::Success);
+    EXPECT_EQ(_ftp->set_server_errno_convention(255, Convention::Unspecified), Result::Success);
+    expect_remove_result(Result::DirectoryNotEmpty);
+}
+
+TEST_F(FtpResultTest, ErrnoProfileCapturedWhenOperationStarts)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    auto first = remove_directory();
+    auto sent = request(10);
+    ASSERT_TRUE(sent);
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::Unspecified), Result::Success);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(first), Result::DirectoryNotEmpty);
+
+    auto second = remove_directory();
+    sent = request(10);
+    ASSERT_TRUE(sent);
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(second), Result::ProtocolError);
+    expect_remove_result(Result::DirectoryNotEmpty);
+}
+
+TEST_F(FtpResultTest, QueuedOperationCapturesProfileAtItsOwnStart)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    auto first = remove_directory();
+    auto sent = request(10);
+    ASSERT_TRUE(sent);
+    auto queued = remove_directory();
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::Unspecified), Result::Success);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(first), Result::DirectoryNotEmpty);
+    sent = request(10);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(queued), Result::ProtocolError);
+}
+
+TEST_F(FtpResultTest, OtherSourceComponentDoesNotUseTargetErrnoProfile)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    expect_remove_result(Result::ProtocolError, {2, 39}, 2, 100);
+}
+
+TEST_F(FtpResultTest, OtherErrorsAndAckRetainTheirResults)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    expect_remove_result(Result::FileDoesNotExist, {2, 2});
+    for (const auto error : {uint8_t{13}, uint8_t{66}, uint8_t{255}}) {
+        SCOPED_TRACE(error);
+        expect_remove_result(Result::ProtocolError, {2, error});
+    }
+    expect_remove_result(Result::ProtocolError, {1}, 1);
+    expect_remove_result(Result::Unsupported, {7}, 1);
+    expect_remove_result(Result::FileExists, {8}, 1);
+    expect_remove_result(Result::FileProtected, {9}, 1);
+    expect_remove_result(Result::FileDoesNotExist, {10}, 1);
+    expect_remove_result(Result::Success, {}, 0, 1, 128);
+}
+
+TEST_F(FtpResultTest, ShortErrnoDoesNotUseUndeclaredDirectoryError)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    expect_remove_result(Result::ProtocolError, {2, 39}, 1);
+    expect_remove_result(Result::ProtocolError, {2, 39}, 0);
+}
+
+TEST_F(FtpResultTest, OtherOperationsDoNotUseDirectoryErrno)
+{
+    ASSERT_EQ(_ftp->set_server_errno_convention(1, Convention::LinuxGeneric), Result::Success);
+    auto remove = start([this](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->remove_file_async("/file", std::move(callback));
+    });
+    auto sent = request(8);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(remove), Result::ProtocolError);
+
+    auto create = start([this](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->create_directory_async("/directory", std::move(callback));
+    });
+    sent = request(9);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(create), Result::ProtocolError);
+
+    auto rename = start([this](mavsdk::Ftp::ResultCallback callback) {
+        _ftp->rename_async("/from", "/to", std::move(callback));
+    });
+    sent = request(13);
+    ASSERT_TRUE(sent);
+    reply(*sent, 129, 2, {2, 39});
+    EXPECT_EQ(result(rename), Result::ProtocolError);
+}
+
+TEST(FtpErrnoResult, DirectoryNotEmptyStringsAndStableValues)
+{
+    EXPECT_EQ(static_cast<int>(mavsdk::MavlinkFtpClient::ClientResult::NoSystem), 12);
+    EXPECT_EQ(static_cast<int>(mavsdk::MavlinkFtpClient::ClientResult::DirectoryNotEmpty), 13);
+    EXPECT_EQ(static_cast<int>(mavsdk::Ftp::Result::NoSystem), 12);
+    EXPECT_EQ(static_cast<int>(mavsdk::Ftp::Result::DirectoryNotEmpty), 13);
+    std::ostringstream api;
+    api << mavsdk::Ftp::Result::DirectoryNotEmpty;
+    EXPECT_EQ(api.str(), "Directory Not Empty");
+}
